{
  "name": "fgc-robot-hospital",
  "version": "1.0.0",
  "description": "FGC Robot Hospital - management system for supporting FGC robotics teams",
  "author": "Eric Fletcher",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/migrate.js && next build",
    "migrate": "node scripts/migrate.js",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "TEST_TYPE=unit jest",
    "test:unit:watch": "TEST_TYPE=unit jest --watch",
    "test:unit:coverage": "TEST_TYPE=unit jest --coverage",
    "test:integration": "TEST_TYPE=integration jest",
    "test:integration:watch": "TEST_TYPE=integration jest --watch",
    "test:integration:coverage": "TEST_TYPE=integration jest --coverage",
    "test:legacy": "TEST_TYPE=legacy jest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.1.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "csv-parser": "^3.2.1",
    "csv-writer": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@jest/globals": "^30.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^30.4.1",
    "postcss": "^8.5.14",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
