# Environment Variables for Vercel Deployment
# These should be set in the Vercel Dashboard under Project Settings > Environment Variables

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# If you're using the Supabase Vercel integration, it sets POSTGRES_URL
# automatically and DATABASE_URL is not needed — the app falls back to
# POSTGRES_URL when DATABASE_URL is unset. Set DATABASE_URL explicitly only
# for local/non-Supabase setups (e.g. docker-compose) or to override.
POSTGRES_URL=postgresql://username:password@host:port/database

# Current event year. Tags new requests/spare-parts records and scopes
# default views. Bump this at the start of each new season.
EVENT_SEASON=2026

# Production optimizations
NODE_ENV=production