# Environment Variables for Vercel Deployment
# These should be set in the Vercel Dashboard under Project Settings > Environment Variables

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# The Supabase Vercel integration sets this automatically in Production.
POSTGRES_URL=postgresql://username:password@host:port/database

# Current event year. Tags new requests/spare-parts records and scopes
# default views. Bump this at the start of each new season.
EVENT_SEASON=2026

# Production optimizations
NODE_ENV=production